    "import pyro.distributions as dist\n",
    "\n",
    "x = torch.zeros(2,2)\n",
    "y = torch.ones(2,2)\n",
    "\n",
    "z = dist.Normal(loc=x,scale=y).rsample()\n",
    "\n",
    "print(z)"
