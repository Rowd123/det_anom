{
  "sampling_rate": 30.0,
  "window_samples": 300,
  "hop_samples": 150,
  "angle_unit": "degrees",
  "pair_id": "PMU_A-PMU_B",
  "preprocessing": {
    "mu": 0.0,
    "sigma": 1.0,
    "max_interpolation_gap": 3,
    "min_valid_fraction": 0.9,
    "timestamp_tolerance": 1e-05,
    "excluded_intervals": []
  },
  "methods": [
    "fft",
    "matrix_pencil",
    "yule_walker",
    "minmax"
  ],
  "frequency_band": [
    0.0,
    2.0
  ],
  "fft": {
    "preprocess": "difference",
    "window": "boxcar",
    "nfft": 512
  },
  "matrix_pencil": {
    "preprocess": "linear",
    "pencil_length": 100,
    "rank": null,
    "svd_relative_tolerance": 0.1,
    "max_rank": 20,
    "rcond": 1e-10
  },
  "yule_walker": {
    "preprocess": "linear",
    "order": 20,
    "nfft": 1024,
    "ridge": 1e-10,
    "power_floor": 1e-30
  },
  "threshold": {
    "mode": "rolling",
    "history_windows": 720,
    "min_history": 60,
    "ddof": 1,
    "k_sigma": 3.0,
    "min_std": 1e-12,
    "update_policy": "all",
    "reset_on_gap": true
  },
  "consensus": {
    "min_methods": 2
  }
}
